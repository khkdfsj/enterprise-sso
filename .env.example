NODE_ENV=development
HOST=127.0.0.1
PORT=3000
ISSUER=http://127.0.0.1:3000
# Production-only exception for an explicitly approved internal HTTP issuer.
ALLOW_INSECURE_HTTP_ISSUER=0
TRUST_PROXY=loopback
INTERNAL_HTTP_REDIRECT_HOSTS=

DB_FILE=./runtime/enterprise-sso.sqlite3

COOKIE_KEYS=replace-with-two-long-random-comma-separated-values
OIDC_JWKS_FILE=./runtime/jwks.json
OIDC_STORAGE_KEY=replace-with-a-long-random-storage-encryption-key
PASSWORD_PEPPER=replace-with-a-long-random-secret

SSO_IDLE_TTL_SECONDS=7200
SSO_ABSOLUTE_TTL_SECONDS=28800
AUTH_CODE_TTL_SECONDS=60
WE_COM_TRANSACTION_TTL_SECONDS=120

WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_CORP_SECRET=
# Optional alternative to WECOM_CORP_SECRET for an existing internal token service.
WECOM_ACCESS_TOKEN_URL=
# Optional authenticated bridge when the database host is not in the WeCom trusted-IP list.
WECOM_USERINFO_BRIDGE_URL=
WECOM_USERINFO_BRIDGE_TOKEN=
WECOM_CALLBACK_URL=
WECOM_OAUTH_SCOPE=snsapi_base

# Development seed only
DEV_CLIENT_ID=demo-app
DEV_CLIENT_SECRET=replace-before-use
DEV_REDIRECT_URI=http://127.0.0.1:8080/callback
DEV_ADMIN_USERNAME=admin
DEV_ADMIN_USERID=dev-admin
DEV_ADMIN_PASSWORD=replace-before-use

# One-time application registration: npm run app:create
APP_NAME=
APP_REDIRECT_URI=
APP_CLIENT_ID=
APP_ACCESS_MODE=rules
APP_PROVISIONING_ENABLED=0
