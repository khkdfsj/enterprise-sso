{
  "name": "enterprise-sso",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Enterprise OIDC SSO with password and WeCom QR authentication",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/cli/migrate.js",
    "seed:dev": "node src/cli/seed-dev.js",
    "app:create": "node src/cli/create-application.js",
    "admin:bootstrap": "node src/cli/bootstrap-admin.js",
    "account:set-password": "node src/cli/set-password.js",
    "term:publish": "node src/cli/publish-term.js",
    "turnover:start": "node src/cli/start-turnover.js",
    "personnel:import": "node src/cli/import-department.js",
    "personnel:verify": "node scripts/verify-migration.js",
    "wecom:sync-identities": "node src/cli/sync-wecom-identities.js",
    "test:e2e": "node scripts/e2e-login.js",
    "test:turnover": "node scripts/e2e-turnover.js",
    "test:ci-e2e": "node scripts/ci-e2e.js",
    "test": "node --test",
    "check": "node scripts/check-syntax.js"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.10",
    "oidc-provider": "^9.12.0",
    "qrcode": "^1.5.4"
  }
